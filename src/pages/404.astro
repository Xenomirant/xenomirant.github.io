---
import Base from '@/layouts/Base.astro';
---
<Base title="404" noindex>
  <section class="nf">
    <div class="tile" aria-hidden="true"></div>
    <h1 class="page-title" data-decode="404 // zone not found">404 // zone not found<span class="cursor" aria-hidden="true">▌</span></h1>
    <p class="lede">this page does not exist.</p>
    <p><a class="go" href="/">← 0 index</a></p>
  </section>
</Base>

<style>
  .nf { position: relative; }
  .nf .page-title { font-size: clamp(1.6rem, 4.5vw, 3.25rem); }
</style>
