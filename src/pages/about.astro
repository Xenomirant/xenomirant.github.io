---
/**
 * /about/ — long bio from src/content/about.mdx (a plain mdx import, not a collection).
 * guarded with import.meta.glob so the build survives while the content agent is still writing it.
 */
import type { MDXInstance } from 'astro';
import Page from '@/layouts/Page.astro';
import { components } from '@/components/mdx';
import { meta } from '@/data/meta';
import EraBg from '@/components/EraBg.astro';

const mods = import.meta.glob<MDXInstance<Record<string, unknown>>>('/src/content/about.mdx', { eager: true });
const about = Object.values(mods)[0];
const About = about?.Content;
---
<Page title="about" zone={5} description={`about ${meta.name}: what I do, how I got here, interests.`}>
  <EraBg kind="bruegel" slot="bg" />
  <div class="prose">
    {About ? <About components={components} /> : <p class="meta">the long version is being written. the short one is on the <a href="/">index</a>.</p>}
  </div>
</Page>

<style>
</style>
