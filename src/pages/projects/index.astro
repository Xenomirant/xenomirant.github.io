---
import { getCollection } from 'astro:content';
import Page from '@/layouts/Page.astro';
import Label from '@/components/Label.astro';
import RowProject from '@/components/RowProject.astro';
import { byDateAsc } from '@/lib/fmt';
import EraBg from '@/components/EraBg.astro';

const all = (await getCollection('projects')).sort(byDateAsc).map((p, i) => ({ p, n: i + 1 })).reverse();
const side = (k: string) => k === 'teaching' || k === 'fieldwork';
const work = all.filter(({ p }) => !side(p.data.kind));
const other = all.filter(({ p }) => side(p.data.kind));
const groups = (['ongoing', 'done', 'dormant'] as const)
  .map((s) => ({ s, rows: work.filter(({ p }) => p.data.status === s) }))
  .filter((g) => g.rows.length > 0);
---
<Page title="projects" zone={4} lede="tools, competitions, teaching." description="projects by Sergei Kudriashov: tools, hackathons, teaching, fieldwork.">
  <EraBg kind="drips" slot="bg" />

  {all.length === 0 && <p class="meta">nothing listed yet.</p>}
  {groups.map(({ s, rows }) => (
    <section class="group" aria-labelledby={`g-${s}`}>
      <Label id={`g-${s}`}>{s} · {rows.length}</Label>
      <ol class="rows">{rows.map(({ p, n }) => <RowProject entry={p} index={n} />)}</ol>
    </section>
  ))}

  {other.length > 0 && (
    <section class="group" aria-labelledby="g-other">
      <Label id="g-other">teaching &amp; fieldwork · {other.length}</Label>
      <ol class="rows">{other.map(({ p, n }) => <RowProject entry={p} index={n} />)}</ol>
    </section>
  )}
</Page>

<style>
  .group + .group { margin-top: 4rem; }
  .project-hero { height: 180px; margin: -1rem 0 2rem; }
  .project-hero .bg { position: relative; inset: auto; height: 100%; }
</style>
