---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import Socials from '@/components/Socials.astro';
import { meta } from '@/data/meta';
import { email } from '@/data/socials';
---
<Base zone={0} description={meta.description} class="screen home">
  <Hero class="hero-wrap">
    <section class="hero-home" aria-label="intro">
      <p class="prompt meta">[ {meta.handle}@shenzhen ~ ] $</p>
      <h1 class="name" data-decode={meta.name}>{meta.name}<span class="cursor" aria-hidden="true">▌</span></h1>
      {meta.bio && <p class="bio">{meta.bio}</p>}
      <Socials class="hero-socials" />
    </section>
  </Hero>
  <section class="facts" aria-label="key information">
    <dl>
      {meta.facts.map((f) => (<><dt>{f.k}</dt><dd>{f.v}</dd></>))}
    </dl>
    <p class="facts-foot">
      <a href="/CV.pdf" target="_blank" rel="noopener">cv ↗</a>
      <a href={`mailto:${email}?subject=${encodeURIComponent("let's chat")}`}>let's chat? <span class="arrow" aria-hidden="true">→</span></a>
    </p>
  </section>
</Base>

<style>
  :global(.hero-socials) { margin-top: 1.2rem; }
  .bio { margin: 0.7rem 0 0; font: 400 clamp(1.1rem, 1.6vw, 1.45rem)/1.2 var(--f-pixel); color: var(--ink-2); font-variant-ligatures: none; }
  :global(main.home .hero-home) { padding-top: 0; padding-bottom: 0; }
</style>
