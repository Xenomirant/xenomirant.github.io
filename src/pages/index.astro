---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import Socials from '@/components/Socials.astro';
import { byEra } from '@/data/zones';
import { meta } from '@/data/meta';
const doors = [
  { era: 'past', line: 'papers, projects, writing, and how I got here', zones: byEra('past') },
  { era: 'present', line: 'what I am working on, and how to reach me', zones: byEra('present') },
  { era: 'future', line: 'open questions', zones: byEra('future') },
] as const;
---
<Base zone={0} description={meta.description} class="screen home">
  <Hero class="hero-wrap">
    <section class="hero-home" aria-label="intro">
      <p class="prompt meta">[ {meta.handle}@shenzhen ~ ] $</p>
      <h1 class="name" data-decode={meta.name}>{meta.name}<span class="cursor" aria-hidden="true">▌</span></h1>
      <p class="bio">
        phd student in ai at cuhk-shenzhen, supervised by zhi-quan tom luo. part-time, i do ai safety
        research with a group in cambridge. formerly a linguist.
      </p>
      <Socials class="hero-socials" />
    </section>
  </Hero>
  <nav class="plate" aria-label="past, present, future">
    {doors.map((d) => (
      <div class="door" data-era={d.era}>
        <a class="door-title" href={d.zones[0].href} data-zone={d.zones[0].n}>{d.era}</a>
        <p class="door-line">{d.line}</p>
        <p class="door-links">{d.zones.map((z, i) => <>{i > 0 && <span class="sep"> · </span>}<a href={z.href} data-zone={z.n}>{z.label}</a></>)}</p>
      </div>
    ))}
  </nav>
</Base>

<style>
  :global(.hero-socials) { margin-top: 1.4rem; }
  :global(main.home .hero-home) { padding-top: 0; padding-bottom: 0; }
</style>
