---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import Base from '@/layouts/Base.astro';
import Chat from '@/components/Chat.astro';
import { meta } from '@/data/meta';
const bgImg = existsSync(resolve(process.cwd(), 'public/img/contact-1600.png')) ? '/img/contact-1600.png' : undefined;
---
<Base title="contact" zone={6} class="contact-page" description={`contact ${meta.name}: email and handles.`}>
  {bgImg && (
    <div class="bg" aria-hidden="true">
      <img src={bgImg} alt="" width="1600" height="1000" loading="eager" decoding="async" />
    </div>
  )}
  <h1 class="visually-hidden">contact</h1>
  <Chat full />
</Base>
