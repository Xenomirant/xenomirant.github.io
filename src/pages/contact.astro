---
import Base from '@/layouts/Base.astro';
import Chat from '@/components/Chat.astro';
import EraBg from '@/components/EraBg.astro';
import { meta } from '@/data/meta';
---
<Base title="contact" zone={6} class="contact-page screen" description={`contact ${meta.name}: email and handles.`}>
  <EraBg kind="grille" slot="bg" />
  <h1 class="visually-hidden">contact</h1>
  <Chat full />
</Base>
