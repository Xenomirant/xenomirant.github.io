---
import { getCollection, render } from 'astro:content';
import Page from '@/layouts/Page.astro';
import { byDateDesc, daysBetween, fmtDate, isoDate } from '@/lib/fmt';

const entries = (await getCollection('now')).sort(byDateDesc);
const latest = entries[0];
const Content = latest ? (await render(latest)).Content : undefined;
const gap = (i: number) => {
  if (i === 0) return '0.6rem';
  const days = daysBetween(entries[i - 1].data.date, entries[i].data.date);
  return `${Math.min(3, Math.max(0.4, days * 0.04)).toFixed(2)}rem`;
};
const utc = (s: string) => (s.startsWith('+') || s.startsWith('-') ? `utc${s}` : `utc+${s}`);
---
<Page title="now" zone={1} description="what Sergei Kudriashov is doing now: a dated log.">
  {latest && Content ? (
    <div class="now-grid">
      <div class="side">
        <p class="meta">
          updated <time datetime={isoDate(latest.data.date)}>{fmtDate(latest.data.date)}</time>
          <span class="sep">//</span>{latest.data.where.toLowerCase()}
          <span class="sep">//</span>{utc(latest.data.utcOffset)}
        </p>
        {latest.data.mood && <p class="mood">{latest.data.mood}</p>}
        {entries.length > 1 && (
          <a class="go" href="#log">log · {entries.length - 1} earlier <span class="arrow" aria-hidden="true">→</span></a>
        )}
      </div>
      <div class="sections">
        <Content />
      </div>
    </div>
  ) : (
    <p class="meta">the log is empty. the clock is still running.</p>
  )}

  {entries.length > 0 && (
    <section class="section" aria-labelledby="log-h">
      <h2 class="label" id="log-h"><span class="br" aria-hidden="true">[</span>log<span class="br" aria-hidden="true">]</span></h2>
      <ol class="log" id="log">
        {entries.map((e, i) => (
          <li class:list={['meta', { live: i === 0 }]} style={`--gap:${gap(i)}`}>
            <a href={`/now/${e.id}/`}><time datetime={isoDate(e.data.date)}>{fmtDate(e.data.date)}</time></a>
            <span class="sep">//</span>{e.data.where.toLowerCase()}
            {e.data.mood && <><span class="sep">//</span><span class="mood-inline">{e.data.mood}</span></>}
          </li>
        ))}
      </ol>
    </section>
  )}
</Page>

<style>
  .side { display: flex; flex-direction: column; gap: 1rem; align-items: flex-start; }
  .mood { font-family: var(--serif); font-style: italic; font-size: 1.3rem; color: var(--ink-2); margin: 0; max-width: 24rem; }
  .mood-inline { font-family: var(--serif); font-style: italic; text-transform: none; letter-spacing: 0; font-size: 0.95rem; }
  /* rendered body: h2 → [ label ] eyebrow, lists → dashed */
  .now-grid .sections { gap: 0; }
  .now-grid .sections :global(h2) {
    display: flex; align-items: center; gap: 0.6em;
    font: var(--t-xs) var(--mono); letter-spacing: 0.04em; text-transform: lowercase; color: var(--ink-3);
    margin: 0 0 0.8rem;
  }
  .now-grid .sections :global(h2::before) {
    content: ''; width: 5px; height: 5px; border-radius: 50%; background: var(--amber); box-shadow: var(--glow); flex: none;
  }
  .now-grid .sections :global(* + h2) { margin-top: 2.5rem; }
  .now-grid .sections :global(p) { margin: 0; color: var(--ink-2); }
  .now-grid .sections :global(a) { text-decoration: underline 1px var(--amber-dim); text-underline-offset: 0.2em; }
  .now-grid .sections :global(a:hover) { color: var(--amber); }
</style>
