---
import { getCollection, render } from 'astro:content';
import Page from '@/layouts/Page.astro';
import EraBg from '@/components/EraBg.astro';
import { byDateDesc, fmtDate, isoDate } from '@/lib/fmt';

const entries = (await getCollection('now')).sort(byDateDesc);
const latest = entries[0];
const Content = latest ? (await render(latest)).Content : undefined;
const utc = (s: string) => (s.startsWith('+') || s.startsWith('-') ? `utc${s}` : `utc+${s}`);
---
<Page title="now" zone={1} description="what Sergei Kudriashov is doing now: a dated log." class="screen now-page">
  <EraBg kind="meireles" slot="bg" />
  {latest && Content ? (
    <div class="now-col">
      <p class="meta">
        updated <time datetime={isoDate(latest.data.date)}>{fmtDate(latest.data.date)}</time>
        <span class="sep">//</span>{latest.data.where.toLowerCase()}
        <span class="sep">//</span>{utc(latest.data.utcOffset)}
      </p>
      {latest.data.mood && <p class="mood">{latest.data.mood}</p>}
      <div class="now-sections"><Content /></div>
      {entries.length > 1 && (
        <ol class="log" aria-label="earlier entries">
          {entries.slice(1).map((e) => (
            <li class="meta"><a href={`/now/${e.id}/`}><time datetime={isoDate(e.data.date)}>{fmtDate(e.data.date)}</time></a><span class="sep">//</span>{e.data.where.toLowerCase()}</li>
          ))}
        </ol>
      )}
    </div>
  ) : (
    <p class="meta">nothing logged yet.</p>
  )}
</Page>
