---
/** desktop navigation: a line that drops from the knob; the past, the present, the future is … hang along it. */
import { tree, cv } from '@/data/zones';
import { meta } from '@/data/meta';
import Sigil from './Sigil.astro';
interface Props { zone?: number }
const { zone } = Astro.props;
---
<nav class="rail" aria-label="the past, the present, the future">
  <a class="rail-brand" href="/" data-zone="0">
    <Sigil zone={zone} title={`zone ${zone ?? '—'}`} />
    <span>{meta.name.toLowerCase()}</span>
  </a>
  <ol class="rail-line">
    {tree.map((b) => (
      <li class="rail-era" data-era={b.era}>
        {b.zone
          ? <a class="era-head" href={b.zone.href} data-zone={b.zone.n} aria-current={b.zone.n === zone ? 'page' : undefined}>{b.label}{b.era === 'future' && <span class="ell" aria-hidden="true"> …</span>}</a>
          : <span class="era-head">{b.label}</span>}
        {b.children.length > 0 && (
          <ol>
            {b.children.map((z) => (
              <li><a href={z.href} data-zone={z.n} aria-current={z.n === zone ? 'page' : undefined}>{z.label}</a></li>
            ))}
          </ol>
        )}
      </li>
    ))}
    <li class="rail-cv">
      <a href={cv.href} target="_blank" rel="noopener" data-zone={cv.n}>{cv.label}<span aria-hidden="true"> ↗</span></a>
    </li>
  </ol>
</nav>
