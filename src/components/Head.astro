---
import { meta } from '@/data/meta';
import { shown, socials } from '@/data/socials';
import Katex from './Katex.astro';
interface Props {
  title?: string; description?: string; image?: string; imageAlt?: string; lang?: string; type?: 'website' | 'article';
  canonical?: string; math?: boolean; noindex?: boolean; date?: Date;
}
const { title, description = meta.description, image = meta.ogImage, imageAlt, type = 'website', canonical, math = false, noindex = false, date } = Astro.props;
const fullTitle = title ? `${title} · ${meta.name}` : `${meta.name} · ${meta.tagline}`;
const url = new URL(Astro.url.pathname, Astro.site);
const img = new URL(image, Astro.site);
const x = socials.find((s) => s.id === 'x' && s.show)?.handle;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: meta.name,
  alternateName: meta.nameVariants.filter((n) => n !== meta.name),
  url: meta.site,
  email: 'xenomirant@gmail.com',
  jobTitle: 'PhD student in artificial intelligence',
  affiliation: meta.affiliations.map((a) => ({ '@type': 'Organization', name: a.name })),
  sameAs: shown.filter((s) => s.url.startsWith('http')).map((s) => s.url),
};
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<!-- before the stylesheet arrives: a dark ground instead of white, and nothing unstyled (Firefox paints early); base.css reveals the body -->
<style is:inline>html{background:#07090c;color:#d9d4c7;color-scheme:dark}a{color:inherit}body{visibility:hidden}</style>
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="google-site-verification" content="J0ovs2DS2BprumC1g7Tj51hdwnN0wsizbo8OecJMiVU" />
<meta name="theme-color" content="#07090c" />
<meta name="color-scheme" content="dark" />
<link rel="canonical" href={canonical ?? url.href} />
{noindex && <meta name="robots" content="noindex" />}
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="alternate" type="application/rss+xml" title={meta.name} href="/rss.xml" />
<meta property="og:type" content={type} />
<meta property="og:site_name" content={meta.name} />
<meta property="og:title" content={title ?? meta.name} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url.href} />
<meta property="og:image" content={img.href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{imageAlt && <meta property="og:image:alt" content={imageAlt} />}
{date && <meta property="article:published_time" content={date.toISOString()} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title ?? meta.name} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={img.href} />
{imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
{x && <meta name="twitter:creator" content={x} />}
{math && <Katex />}
<script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
<script is:inline>
  (function () {
    var d = document.documentElement;
    d.classList.add('js');
    // failsafe: if the stylesheet never loads, show the page anyway
    setTimeout(function () { if (document.body && getComputedStyle(document.body).visibility === 'hidden') document.body.style.visibility = 'visible'; }, 3000);
    try { var m = localStorage.getItem('motion'); if (m === 'off') d.dataset.motion = 'off'; } catch (e) {}
    // the name/title decodes once per page per tab: keep it hidden until the scramble starts, so it never shows, then scrambles
    try {
      var still = d.dataset.motion === 'off' || matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!still && !sessionStorage.getItem('decoded:' + location.pathname)) d.classList.add('decoding');
    } catch (e) {}
    try {
      if (sessionStorage.getItem('knob:from') !== null && d.dataset.motion !== 'off' && !matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('arriving');
    } catch (e) {}
  })();
</script>
