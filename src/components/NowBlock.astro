---
/** latest log entry as a yellow sign plate; silent when stale. */
import { getCollection, render } from 'astro:content';
import { meta } from '@/data/meta';
import { byDateDesc, daysAgo, fmtDate, isoDate } from '@/lib/fmt';
const entries = (await getCollection('now')).sort(byDateDesc);
const latest = entries[0];
const fresh = latest && daysAgo(latest.data.date) <= meta.staleNowDays;
const Content = fresh ? (await render(latest)).Content : undefined;
---
{fresh && Content && (
  <aside class="now-block" aria-labelledby="now-h">
    <header class="plate-head">
      <h2 class="plate-title" id="now-h"><a href="/now/" data-zone="1">now</a></h2>
      <p class="plate-meta"><time datetime={isoDate(latest.data.date)}>{fmtDate(latest.data.date)}</time> // {latest.data.where.toLowerCase()}</p>
    </header>
    <div class="plate-body"><Content /></div>
  </aside>
)}
