---
import { getCollection } from 'astro:content';
import { syzygy } from '@/data/zones';
import { meta } from '@/data/meta';
interface Props { zone?: number; date?: Date }
const { zone, date } = Astro.props;
const nowEntries = (await getCollection('now')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = nowEntries[0]?.data;
const pair = zone !== undefined ? syzygy(zone) : undefined;
const fmt = (d: Date) => d.toISOString().slice(0, 10).replaceAll('-', '.');
const stamp = fmt(date ?? new Date());
const where = latest?.where ?? 'shenzhen';
const tz = latest?.tz ?? 'Asia/Shanghai';
const utc = latest?.utcOffset ?? '+8';
const buildTime = new Intl.DateTimeFormat('en-GB', { timeZone: tz, hour: '2-digit', minute: '2-digit', hour12: false }).format(new Date());
---
<footer class="footer" data-footer>
  {zone !== undefined && <span>§{zone}</span>}
  <span class="sep">//</span>
  <span>{stamp}</span>
  <span class="sep">//</span>
  <span>{where} · utc{utc} <time data-clock data-tz={tz}>{buildTime}</time></span>
  {pair && (
    <>
      <span class="sep pair">//</span>
      <span class="pair">see also: <a href={pair.href} target={pair.external ? '_blank' : undefined}>{pair.n} {pair.label}{pair.external ? ' ↗' : ''}</a></span>
    </>
  )}
  <span class="spacer"></span>
  <button type="button" data-motion-toggle aria-pressed="true">motion: <span data-motion-state>on</span></button>
  <span class="sep">//</span>
  <a href="/about/" data-zone="5">about</a>
  <span class="sep">·</span>
  <a href="/rss.xml">feed</a>
  <span class="sep">·</span>
  <a href={meta.repo} target="_blank" rel="noopener">src ↗</a>
</footer>
