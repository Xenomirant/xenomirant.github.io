---
/** two ways for several models to work together: private contexts plus an append-only transcript, or one shared, editable context.
    both panels share one grid: model row, wires, context frame, footnote. */
const W = 300;
const Y = { head: 12, model: 28, modelH: 42, label: 84, wire: [90, 112], frame: 116, frameH: 120, foot: 252 };
const cols = [12 + 39, 110 + 39, 208 + 39]; // centres of the three model columns
const lines: [string, number][] = [['a', 150], ['b', 110], ['a', 170], ['c', 90], ['b', 140], ['a', 120], ['c', 160]];
// shared context rows: segments [author, x, width]; note = a short label after the row
const rows: { segs: [string, number, number][]; cls?: string; note?: string }[] = [
  { segs: [['a', 0, 110], ['b', 114, 60]] },
  { segs: [['c', 0, 150]], cls: 'rw rw1' },
  { segs: [['ab', 0, 140]], note: 'a + b' },
  { segs: [['b', 0, 70], ['struck', 74, 70]], note: 'rewritten' },
  { segs: [['a', 0, 170]], cls: 'rw rw2' },
  { segs: [['bc', 0, 120], ['a', 124, 40]] },
  { segs: [['c', 0, 100]] },
];
---
<figure class="fig fig-shared">
  <div class="fig-panels two">
    <svg viewBox={`0 0 ${W} 260`} role="img" aria-label="today: three models, each with a private context, append labelled messages to one transcript">
      <defs><marker id="arr" viewBox="0 0 6 6" refX="5" refY="3" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 6 3 0 6z" class="arrowhead" /></marker></defs>
      <text x="0" y={Y.head} class="fig-h">today</text>
      {['a', 'b', 'c'].map((m, i) => (
        <g>
          <rect x={cols[i] - 39} y={Y.model} width="78" height={Y.modelH} class="frame" />
          <rect x={cols[i] - 31} y={Y.model + 9} width="50" height="5" class={m} />
          <rect x={cols[i] - 31} y={Y.model + 19} width="62" height="5" class={m} />
          <rect x={cols[i] - 31} y={Y.model + 29} width="36" height="5" class={m} />
          <text x={cols[i]} y={Y.label} text-anchor="middle" class="fig-t">model {m}</text>
          <line x1={cols[i]} y1={Y.wire[0]} x2={cols[i]} y2={Y.wire[1]} class="wire" marker-end="url(#arr)" />
        </g>
      ))}
      <text x={W} y={Y.model - 4} text-anchor="end" class="fig-t dim">private contexts</text>
      <rect x="12" y={Y.frame} width="274" height={Y.frameH} class="frame" />
      {lines.map(([m, len], i) => (
        <g transform={`translate(22, ${Y.frame + 12 + i * 15})`}>
          <text x="0" y="6" class="fig-t tag">[{m}]</text>
          <rect x="26" y="1" width={len} height="5" class={m} />
        </g>
      ))}
      <text x="12" y={Y.foot} class="fig-t">a transcript: append only, every line labelled</text>
    </svg>
    <svg viewBox={`0 0 ${W} 260`} role="img" aria-label="siamese: three models read and rewrite one shared context of bounded length; authorship blurs">
      <defs>
        <marker id="arr2" viewBox="0 0 6 6" refX="5" refY="3" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 6 3 0 6z" class="arrowhead" /></marker>
        <linearGradient id="g-ab"><stop offset="0" class="s-a" /><stop offset="1" class="s-b" /></linearGradient>
        <linearGradient id="g-bc"><stop offset="0" class="s-b" /><stop offset="1" class="s-c" /></linearGradient>
      </defs>
      <text x="0" y={Y.head} class="fig-h">siamese</text>
      {['a', 'b', 'c'].map((m, i) => (
        <g>
          <rect x={cols[i] - 39} y={Y.model} width="78" height={Y.modelH} class="frame dashed-soft" />
          <text x={cols[i]} y={Y.model + 25} text-anchor="middle" class="fig-t dim">empty</text>
          <text x={cols[i]} y={Y.label} text-anchor="middle" class="fig-t">model {m}</text>
          <line x1={cols[i]} y1={Y.wire[0]} x2={cols[i]} y2={Y.wire[1]} class="wire" marker-start="url(#arr2)" marker-end="url(#arr2)" />
        </g>
      ))}
      <text x={W} y={Y.model - 4} text-anchor="end" class="fig-t dim">no private contexts</text>
      <rect x="12" y={Y.frame} width="274" height={Y.frameH} class="frame limit" />
      {rows.map((r, i) => (
        <g transform={`translate(22, ${Y.frame + 12 + i * 15})`} class={r.cls}>
          {r.segs.map(([m, x, w]) => m === 'struck'
            ? <g><rect x={x} y="1" width={w} height="5" class="b ghost" /><line x1={x - 2} y1="3.5" x2={x + w + 2} y2="3.5" class="strike" /></g>
            : <rect x={x} y="1" width={w} height="5" class={m.length > 1 ? `mix-${m}` : m} />)}
          {r.note && <text x={Math.max(...r.segs.map(([, x, w]) => x + w)) + 8} y="6" class="fig-t dim">{r.note}</text>}
        </g>
      ))}
      <text x="12" y={Y.foot} class="fig-t">one context: everyone reads and rewrites it</text>
    </svg>
  </div>
  <p class="fig-legend" aria-hidden="true"><span><i class="sw a"></i>written by model a</span><span><i class="sw b"></i>model b</span><span><i class="sw c"></i>model c</span><span><i class="sw mix"></i>mixed authorship</span></p>
  <figcaption>today, each model keeps its own context and the others reach it only through a labelled transcript. in a siamese setup there is one context, of bounded length, that every model can rewrite, so who wrote what is something the models have to keep track of themselves.</figcaption>
</figure>
