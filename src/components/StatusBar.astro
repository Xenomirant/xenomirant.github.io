---
import { flat, cv } from '@/data/zones';
interface Props { zone?: number }
const { zone } = Astro.props;
const nav = [...flat, cv];
---
<div class="statusbar" data-statusbar>
  <nav aria-label="zones">
    {nav.map((z) => (
      <a
        href={z.href}
        aria-current={z.n === zone ? 'page' : undefined}
        target={z.external ? '_blank' : undefined}
        rel={z.external ? 'noopener' : undefined}
        data-zone={z.n}
      >
        {z.short ?? z.label}{z.external && <span aria-hidden="true"> ↗</span>}
      </a>
    ))}
  </nav>
</div>
