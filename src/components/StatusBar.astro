---
import { zones } from '@/data/zones';
import { meta } from '@/data/meta';
import Sigil from './Sigil.astro';
interface Props { zone?: number }
const { zone } = Astro.props;
const nav = zones.filter((z) => z.nav);
---
<header class="statusbar" data-statusbar>
  <a class="brand" href="/" aria-label="home">
    <Sigil zone={zone} title={`zone ${zone ?? '—'}`} />
    <span>{meta.name.toLowerCase()}</span>
    <span class="dots" aria-hidden="true">··</span>
  </a>
  <nav aria-label="zones">
    {nav.map((z) => (
      <a
        href={z.href}
        aria-current={z.n === zone ? 'page' : undefined}
        target={z.external ? '_blank' : undefined}
        rel={z.external ? 'noopener' : undefined}
        data-zone={z.n}
      >
        <span class="n">{z.n}</span>{z.label}{z.external && <span aria-hidden="true"> ↗</span>}
      </a>
    ))}
  </nav>
</header>
