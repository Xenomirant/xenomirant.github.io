---
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/barlow-condensed/500.css';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/grenze-gotisch/latin-500.css';
import '@fontsource/grenze-gotisch/latin-600.css';
import '@fontsource/special-elite/latin-400.css';
import '@fontsource/pixelify-sans/latin-400.css';
import '@fontsource/pixelify-sans/latin-600.css';
import '@fontsource/rubik-broken-fax/latin-400.css';
import '@fontsource/dotgothic16/latin-400.css';
import '@fontsource/syne-mono/latin-400.css';
import '@fontsource/major-mono-display/latin-400.css';
import '@/styles/global.css';
import Head from '@/components/Head.astro';
import StatusBar from '@/components/StatusBar.astro';
import Rail from '@/components/Rail.astro';
import Footer from '@/components/Footer.astro';
import Sigil from '@/components/Sigil.astro';
import { meta } from '@/data/meta';
import { eraOf } from '@/data/zones';
// fonts seen at first paint, fetched alongside the css instead of after it (same files the css points to)
import plexMono from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import majorMono from '@fontsource/major-mono-display/files/major-mono-display-latin-400-normal.woff2?url';
import pixelify from '@fontsource/pixelify-sans/files/pixelify-sans-latin-400-normal.woff2?url';
import grenze from '@fontsource/grenze-gotisch/files/grenze-gotisch-latin-500-normal.woff2?url';
import specialElite from '@fontsource/special-elite/files/special-elite-latin-400-normal.woff2?url';
import brokenFax from '@fontsource/rubik-broken-fax/files/rubik-broken-fax-latin-400-normal.woff2?url';
interface Props {
  title?: string; description?: string; zone?: number; lang?: 'en' | 'ru'; image?: string;
  type?: 'website' | 'article'; canonical?: string; math?: boolean; noindex?: boolean; date?: Date; class?: string;
}
const { title, description, zone, lang = 'en', image, type, canonical, math, noindex, date, class: cls } = Astro.props;
const era = eraOf(zone);
const eraFonts = { present: [pixelify], past: [grenze, specialElite], future: [brokenFax] }[era];
const preload = [plexMono, majorMono, ...eraFonts];
---
<!doctype html>
<html lang={lang} data-zone={zone} data-era={era}>
  <head>
    <Head {title} {description} {image} {type} {canonical} {math} {noindex} {date} />
    {preload.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">skip to content</a>
    <div class="shell">
      <Rail {zone} />
      <header class="topline">
        <a class="brand" href="/" data-zone="0"><Sigil zone={zone} title={`zone ${zone ?? '—'}`} /><span>{meta.name.toLowerCase()}</span></a>
      </header>
      <slot name="bg" />
      <main id="main" class:list={['content', cls]} tabindex="-1">
        <slot />
      </main>
      <StatusBar {zone} />
      <Footer {zone} {date} />
    </div>
    <slot name="after" />
    <script src="@/scripts/site.ts"></script>
  </body>
</html>
